{
  "$meta": {
    "name": "AECPilot design tokens",
    "version": "2026-07-12",
    "direction": "Linear-подобный светлый минимал",
    "themes": ["light", "dark"],
    "usage": "CSS-переменные в tokens.css; здесь — переносимый JSON-исходник."
  },
  "color": {
    "light": {
      "bg-app": "#F6F6F5", "bg-sidebar": "#FAFAF9", "bg-surface": "#FFFFFF", "bg-raised": "#FFFFFF",
      "bg-hover": "rgba(24,24,30,.05)", "bg-active": "rgba(94,106,210,.10)",
      "border": "rgba(24,24,30,.10)", "border-strong": "rgba(24,24,30,.16)",
      "text-1": "#1C1C21", "text-2": "#585862", "text-3": "#8B8B94",
      "accent": "#5E6AD2", "accent-hover": "#4854B8", "accent-soft": "rgba(94,106,210,.12)", "on-accent": "#FFFFFF",
      "success": "#1E9E58", "success-soft": "rgba(30,158,88,.12)",
      "warning": "#9A6700", "warning-soft": "rgba(178,125,10,.12)",
      "danger": "#D14343", "danger-soft": "rgba(209,67,67,.12)",
      "page": "#FFFFFF", "page-border": "rgba(24,24,30,.12)"
    },
    "dark": {
      "bg-app": "#111113", "bg-sidebar": "#161619", "bg-surface": "#1B1B1F", "bg-raised": "#232329",
      "bg-hover": "rgba(255,255,255,.06)", "bg-active": "rgba(123,135,232,.16)",
      "border": "rgba(255,255,255,.09)", "border-strong": "rgba(255,255,255,.16)",
      "text-1": "#EDEDEF", "text-2": "#A6A6B0", "text-3": "#74747E",
      "accent": "#7B87E8", "accent-hover": "#97A1F0", "accent-soft": "rgba(123,135,232,.17)", "on-accent": "#FFFFFF",
      "success": "#4CC38A", "success-soft": "rgba(76,195,138,.14)",
      "warning": "#E0B13F", "warning-soft": "rgba(224,177,63,.14)",
      "danger": "#F07272", "danger-soft": "rgba(240,114,114,.14)",
      "page": "#EDEDEB", "page-border": "rgba(0,0,0,.25)"
    }
  },
  "typography": {
    "font-ui": "-apple-system, 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
    "font-mono": "'Cascadia Mono', 'JetBrains Mono', ui-monospace, Consolas, monospace",
    "size": { "caption": 11, "small": 12, "body": 13, "chat": 14, "h2": 15, "h1": 18 },
    "line-height-body": 1.45
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24 },
  "size": { "row-h": 28, "control-h": 28, "topbar-h": 44, "status-h": 26, "rail-w": 44 },
  "radius": { "chip": 4, "ctl": 6, "card": 8, "modal": 10 },
  "shadow": {
    "light": { "raised": "0 1px 2px rgba(20,20,25,.05)", "popover": "0 4px 16px rgba(20,20,25,.12)", "modal": "0 8px 32px rgba(20,20,25,.18)" },
    "dark": { "raised": "0 1px 2px rgba(0,0,0,.30)", "popover": "0 4px 16px rgba(0,0,0,.40)", "modal": "0 8px 32px rgba(0,0,0,.50)" }
  }
}
