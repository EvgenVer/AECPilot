{
  // Обвязка автоприёмки (задача 3F.1) — отдельным проектом, а не в `tsconfig.json`.
  // Причина: на ней стоят сотни проверок чек-листа, и опечатка в общем помощнике
  // иначе всплыла бы только в прогоне. Сам `donor-shell-smoke.spec.ts` сюда НЕ
  // включён: он писался без проверки типов (58 ошибок, все — следствие импорта
  // типов из пакета `playwright`, которого нет в прямых зависимостях), и его
  // правка — не часть этой задачи.
  "extends": "./tsconfig.json",
  // `src/renderer/src/global.d.ts` — объявление `window.aecpilot`: тесты
  // ходят в наш мост через `page.evaluate`, и без него это `any`.
  "include": ["e2e/lib", "e2e/acceptance", "playwright.config.ts", "src/renderer/src/global.d.ts"]
}
