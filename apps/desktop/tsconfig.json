{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@hermes/shared": ["./src/renderer/src/shared/hermes-shared/index.ts"],
      "@hermes/shared/*": ["./src/renderer/src/shared/hermes-shared/*"],
      "@hermes/plugin-sdk": ["./src/renderer/src/donor/sdk/index.ts"],
      "@/*": ["./src/renderer/src/donor/*"]
    }
  },
  "include": ["src", "electron.vite.config.ts"],
  // Their `vitest.setup.ts` sits at THEIR app root, outside their `include: ["src"]`,
  // so upstream never type-checks it; ours lives beside the zone and is held to
  // the same rule (3.B6: its jsdom stubs do not satisfy TS 6 DOM types).
  "exclude": ["src/renderer/src/donor/vitest.setup.ts"]
}
